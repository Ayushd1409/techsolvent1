<IfModule mod_dir.c>
  DirectorySlash Off
</IfModule>

<IfModule mod_headers.c>
  # Prevent CDN and proxies from caching stale redirects or HTML pages
  <FilesMatch "\.(html|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Existing physical static assets (JS, CSS, images, icons, fonts)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Dynamic Unified Router (Serves 200 OK directly for all pages, eliminates 301 redirects, sets matching self-referencing canonicals)
  RewriteRule ^ router.php [L]
</IfModule>

